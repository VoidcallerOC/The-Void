# Server-only persistence configuration. Never expose these as VITE_* variables.
DATABASE_URL=postgresql://user:password@localhost:5432/voidcaller
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
APP_SHUTDOWN_TIMEOUT_MS=15000

# Ownership authorization fails closed when the durable index is stale or too
# far behind its observed chain head. Tune only with monitoring in place.
OWNERSHIP_MAX_INDEXER_LAG_BLOCKS=24
OWNERSHIP_MAX_INDEXER_STALENESS_MS=120000

# Application/runtime configuration
NODE_ENV=development
PUBLIC_APP_URL=http://localhost:5173
# When the static web host and Node API use different origins, expose this
# non-secret frontend value at build time and allow its exact origin server-side.
# VITE_API_ORIGIN=https://api.example.com
# API_ALLOWED_ORIGINS=https://app.example.com
# Authentication binds challenges to this exact public origin. Development and
# staging use Fuji (43113); production must use HTTPS and C-Chain (43114) only.
# AUTH_DOMAIN=localhost:5173
# AUTH_URI=http://localhost:5173
AUTH_ALLOWED_CHAIN_IDS=43113
AUTH_CHALLENGE_TTL_SECONDS=300
AUTH_SESSION_TTL_SECONDS=3600

# Indexer worker configuration. Do not configure an address until a reviewed
# deployment has been verified and registered in the contracts table. Fuji is
# staging (43113); production must use C-Chain (43114) only.
# INDEXER_CHAIN_ID=43113
# INDEXER_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# INDEXER_CONFIRMATIONS=12
# INDEXER_CHUNK_SIZE=500
# INDEXER_POLL_INTERVAL_MS=15000
# INDEXER_RPC_TIMEOUT_MS=15000
# INDEXER_RPC_RETRIES=4
# INDEXER_RETRY_BASE_DELAY_MS=250
# INDEXER_OWNERSHIP_RECONCILIATION_INTERVAL_MS=900000
# INDEXER_LEASE_TTL_MS=90000
#
# JSON array: each contract must have chainId, address, contractType, and an
# exact deployment startBlock. Only ERC1155 and MARKETPLACE are accepted.
# For MARKETPLACE, platformFeeBps is optional but recommended when immutable.
# INDEXER_CONTRACTS_JSON=[{"chainId":43113,"address":"0x0000000000000000000000000000000000000000","contractType":"ERC1155","startBlock":123456},{"chainId":43113,"address":"0x0000000000000000000000000000000000000000","contractType":"MARKETPLACE","startBlock":123456,"platformFeeBps":250}]

# Protected media. Filesystem storage is development-only and must point
# outside public/. Production requires MEDIA_STORAGE_DRIVER=object and a
# provider-neutral signing service. The signer receives only storageKey and a
# short expiration request, then returns one HTTPS URL on an approved host.
# MEDIA_STORAGE_DRIVER=filesystem
# MEDIA_PRIVATE_ROOT=/absolute/path/outside/the/web/root
# MEDIA_GRANT_TTL_SECONDS=300
# MEDIA_SIGNED_URL_TTL_SECONDS=60
# MEDIA_MAX_BYTES=104857600
# MEDIA_AUDIT_HASH_SECRET=replace-with-a-unique-32-plus-character-secret
#
# Required when MEDIA_STORAGE_DRIVER=object (required in production):
# MEDIA_STORAGE_DRIVER=object
# MEDIA_OBJECT_SIGNER_ENDPOINT=https://media-signer.example.internal/sign
# MEDIA_OBJECT_SIGNER_TOKEN=replace-with-a-secret-service-token-of-24-plus-characters
# MEDIA_OBJECT_URL_HOSTS=private-media.example.com,cdn-private.example.com

# Fuji staging only. Store actual values in the hosting provider's secret manager.
NODE_ENV=production
PORT=8787
PUBLIC_APP_URL=https://staging.example.com
API_ALLOWED_ORIGINS=https://staging.example.com
AUTH_DOMAIN=https://staging.example.com
AUTH_URI=https://staging.example.com/login

# Managed PostgreSQL connection string. Use TLS-capable URL and DATABASE_SSL=true.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000

# Avalanche Fuji chain ID is 43113.
INDEXER_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
INDEXER_CHAIN_ID=43113
INDEXER_CONFIRMATIONS=12
INDEXER_POLL_INTERVAL_MS=15000
# JSON array; include only deployed contracts and their actual deployment start blocks.
# Example: [{"address":"0x...","contractType":"MARKETPLACE","startBlock":123,"eventTopics":{}}]
INDEXER_CONTRACTS_JSON=

# Deployed Fuji marketplace configuration.
MARKETPLACE_ADDRESS=
MARKETPLACE_CHAIN_ID=43113

# Protected masters are never served from public/assets. Use a private mounted volume
# or a provider-backed adapter in production; this adapter reads only server-side.
PRIVATE_MEDIA_ROOT=./private-media
MEDIA_STORAGE_MODE=filesystem

# Never put signer keys, auth secrets, media secrets, or database credentials in git.

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "cd ../.. && VITE_RELEASE_NETWORK=mainnet VITE_MARKETPLACE_CHAIN_ID=43114 VITE_MARKETPLACE_ADDRESS=0x75964C44cA586b13e98e7c30E74d2B4114f65b06 VITE_MARKETPLACE_FEE_BPS=250 npx vite build --outDir deploy/vercel-mainnet/dist --emptyOutDir",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/assets/audio(?:/.*)?",
      "status": 404
    },
    {
      "src": "/assets/audio-preview/(?!.*-preview\\.mp3$).*",
      "status": 404
    }
  ],
  "rewrites": [
    {
      "source": "/assets/marketplace-heroes/:file",
      "destination": "https://the-void-api-mainnet.onrender.com/api/marketplace/heroes/:file"
    },
    {
      "source": "/assets/artist-portfolio/:file",
      "destination": "https://the-void-api-mainnet.onrender.com/api/artists/portfolio/:file"
    },
    {
      "source": "/api/:path*",
      "destination": "https://the-void-api-mainnet.onrender.com/api/:path*"
    },
    {
      "source": "/owner-deploy",
      "destination": "/owner-deploy.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/owner-deploy(.html)?",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}

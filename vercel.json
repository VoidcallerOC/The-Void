{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    { "src": "/assets/audio(?:/.*)?", "status": 404 },
    { "src": "/assets/audio-preview/(?!.*-preview\\.mp3$).*", "status": 404 }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://the-void-api-fuji.onrender.com/api/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
